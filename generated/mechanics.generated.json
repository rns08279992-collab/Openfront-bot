      ]
    },
    "nukeDeathFactor": {
      "kind": "formula",
      "sourceFile": ".tmp/OpenFrontIO-upstream/src/core/configuration/DefaultConfig.ts",
      "sourceExpression": "if (nukeType !== UnitType.MIRVWarhead) { return (5 * humans) / Math.max(1, tilesOwned); } const targetTroops = 0.03 * maxTroops; const excessTroops = Math.max(0, humans - targetTroops); const scalingFactor = 500; const steepness = 2; const normalizedExcess = excessTroops / maxTroops; return scalingFactor * (1 - Math.exp(-steepness * normalizedExcess));",
      "dependsOn": [
        "nukeType",
