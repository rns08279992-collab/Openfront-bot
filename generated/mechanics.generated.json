      "kind": "formula",
      "sourceFile": ".tmp/OpenFrontIO-upstream/src/core/configuration/DefaultConfig.ts",
      "sourceExpression": "const base = this.goldMultiplier(); const hc = this._gameConfig.hostCheats; if (hc?.goldMultiplier && player.isLobbyCreator()) { return hc.goldMultiplier; } return base;",
      "dependsOn": [
