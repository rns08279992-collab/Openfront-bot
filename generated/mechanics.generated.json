      ]
    },
    "attackTilesPerTick": {
      "kind": "formula",
      "sourceFile": ".tmp/OpenFrontIO-upstream/src/core/configuration/DefaultConfig.ts",
      "sourceExpression": "if (defender.isPlayer()) { return ( within(((5 * attackTroops) / defender.troops()) * 2, 0.01, 0.5) * numAdjacentTilesWithEnemy * 3 ); } else { return numAdjacentTilesWithEnemy * 2; }",
      "dependsOn": [
        "attackTroops",
        "defenderTroops",
        "numAdjacentTilesWithEnemy",
        "defenderType"
      ]
    },
    "attackAmount": {
      "kind": "formula",
      "sourceFile": ".tmp/OpenFrontIO-upstream/src/core/configuration/DefaultConfig.ts",
      "sourceExpression": "if (attacker.type() === PlayerType.Bot) { return attacker.troops() / 20; } else { return attacker.troops() / 5; }",
      "dependsOn": [
