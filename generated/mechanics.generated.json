      ]
    },
    "boatAttackAmount": {
      "kind": "formula",
      "sourceFile": ".tmp/OpenFrontIO-upstream/src/core/configuration/DefaultConfig.ts",
      "sourceExpression": "return Math.floor(attacker.troops() / 5);",
      "dependsOn": [
        "attackerTroops"
      ]
    },
    "samRange": {
      "kind": "formula",
      "sourceFile": ".tmp/OpenFrontIO-upstream/src/core/configuration/DefaultConfig.ts",
      "sourceExpression": "this.maxSamRange() - 480 / (level + 5)",
      "dependsOn": [
